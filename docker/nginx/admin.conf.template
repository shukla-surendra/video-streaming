# Admin panel. Kept on its own port/host so it can be firewalled or put
# behind a VPN separately from the public viewer site.
# Pages, scripts and playlists are text: compress them (hls.js is 600 KB raw,
# ~190 KB gzipped). Video segments are already compressed, so leave them.
gzip on;
gzip_types application/javascript text/css application/json application/vnd.apple.mpegurl;
gzip_min_length 1024;
gzip_proxied any;

server {
    listen 80;
    root /usr/share/nginx/html;

    location = /         { return 302 /admin; }
    location = /admin    { try_files /admin.html =404; }
    location /static/    { expires 1h; }
    location = /static/config.js {
        default_type application/javascript;
        add_header Cache-Control no-cache;
        # SITE_URL / ADMIN_URL unset → same host the browser used, so links work
        # from a phone on the LAN (http://192.168.x.x:8080), not just "localhost".
        return 200 "window.VSTREAM = {\n  siteUrl: '${SITE_URL}' || location.protocol + '//' + location.hostname + ':${FRONTEND_PORT}',\n  adminUrl: '${ADMIN_URL}' || location.protocol + '//' + location.hostname + ':${ADMIN_PORT}',\n};\n";
    }

    location /api/admin/ {
        proxy_pass http://${BACKEND_ADDR};
        # Stream uploads straight through instead of buffering GBs to nginx's disk first,
        # so the browser's progress bar matches what the backend has received.
        client_max_body_size ${VSTREAM_MAX_UPLOAD_MB}m;
        proxy_request_buffering off;
        proxy_send_timeout 1h;
        proxy_read_timeout 1h;
    }

    # Thumbnails in the library list.
    location /stream/ {
        proxy_pass http://${BACKEND_ADDR};
    }

    location / { return 404; }
}
