# Copy to .env and change. Compose reads .env automatically.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Public URLs of the two sites (used for the Browse/Admin/Watch links between them).
SITE_URL=http://localhost:8080
ADMIN_URL=http://localhost:8081

# Host ports
FRONTEND_PORT=8080
ADMIN_PORT=8081
BACKEND_PORT=3000
RTMP_PORT=1935
SRT_PORT=8890

# Ingest addresses shown to broadcasters in the admin panel. Use your machine's
# LAN IP or domain if OBS runs on another computer or a phone.
LIVE_RTMP_URL=rtmp://localhost:1935/live
LIVE_SRT_URL=srt://localhost:8890

VSTREAM_MAX_UPLOAD_MB=4096
# Uploads transcoded at once. Each ffmpeg uses several cores; 1 is right for a laptop.
VSTREAM_WORKERS=1
